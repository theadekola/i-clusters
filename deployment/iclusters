#!/usr/bin/env bash
set -Eeuo pipefail
[[ $EUID == 0 ]] || { echo 'Run sudo iclusters ...' >&2; exit 1; }
cd /opt/i-clusters
command=${1:-help}
case "$command" in
  status) docker compose ps;;
  logs) docker compose logs --tail=100 -f;;
  start) systemctl start i-clusters;;
  stop) systemctl stop i-clusters;;
  restart) docker compose up -d --wait --wait-timeout 180;;
  config) "${EDITOR:-nano}" .env;;
  trusted-https) shift; exec python3 deployment/trusted-https.py "$@";;
  certificate)
    case "${2:-}" in
      '') docker compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt </dev/null ;;
      --apple-profile)
        grep -qx 'CADDY_TLS=tls internal' .env || { echo 'The Apple trust profile is for controllers using the built-in LAN CA.' >&2; exit 1; }
        docker compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt </dev/null |
          python3 deployment/apple-trust-profile.py
        ;;
      *) echo 'Usage: sudo iclusters certificate [--apple-profile]' >&2; exit 2 ;;
    esac
    ;;
  backup) bash deployment/controller-backup.sh "${2:?Backup directory required}" "${3:?age public recipient required}";;
  recover-account)
    username=${2:?Username required}
    read -rsp 'New password: ' account_password; echo
    read -rsp 'Confirm password: ' account_confirm; echo
    [[ $account_password == "$account_confirm" ]] || { echo 'Passwords do not match.' >&2; exit 1; }
    printf '%s\n' "$account_password" | docker compose exec -T api node scripts/recover-account.mjs "$username" "${3:-}"
    unset account_password account_confirm
    ;;
  update) bash deployment/upgrade.sh;;
  *) echo 'Usage: sudo iclusters {status|logs|start|stop|restart|config|certificate|trusted-https|update|backup|recover-account}';;
esac
